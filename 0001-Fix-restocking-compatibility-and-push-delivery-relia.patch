-  const recipientIds =
+  excludeUserIds = [],
+}) {
+  try {
+    await refreshPendingExpoReceipts();
+  } catch (error) {
+    console.error(
+      "Expo push receipt refresh error:",
+      error
+    );
+  }
+
+  const recipientIds =
     await getApprovedRecipientIds(
       excludeUserIds
     );
